# URL pública final do checkout externo BravoPay. Nunca use tokens ou segredos em NEXT_PUBLIC_*.
NEXT_PUBLIC_BRAVOPAY_CHECKOUT_URL=

# Lista separada por vírgulas com os hosts HTTPS autorizados para o checkout real.
# Exemplo após confirmação do fornecedor: checkout.exemplo-autorizado.com
NEXT_PUBLIC_BRAVOPAY_ALLOWED_HOSTS=

# URL HTTPS pública real do site, usada para canonical, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=

# IDs públicos opcionais. Não invente valores; o site continua funcionando se ficarem vazios.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
