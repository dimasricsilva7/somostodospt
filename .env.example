# URL pública final do checkout externo confirmado. Nunca use tokens ou segredos em NEXT_PUBLIC_*.
NEXT_PUBLIC_EXTERNAL_CHECKOUT_URL=

# Lista separada por vírgulas com hosts HTTPS expressamente confirmados para o checkout real.
NEXT_PUBLIC_EXTERNAL_CHECKOUT_ALLOWED_HOSTS=

# URL HTTPS pública real do site, usada para canonical, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=

# IDs públicos opcionais. Não invente valores; o site continua funcionando se ficarem vazios.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
