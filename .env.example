# ─────────────────────────────────────────────────────────────────────────────
# Somos Todos PT — variáveis de ambiente
# Copie para .env.local (dev) e configure na Vercel (produção).
# NUNCA faça commit de .env / .env.local. Nenhum segredo em NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados PostgreSQL (Neon). Pooled para a aplicação; UNPOOLED para migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# URL HTTPS pública real do site (sem barra final). Usada no canonical, OG, sitemap,
# nos links do pedido e no event_source_url do CAPI.
NEXT_PUBLIC_SITE_URL=

# Segredo para hash não reversível de IP (LGPD). 32+ bytes aleatórios.
AUTH_SECRET=

# ── BravoPay (PIX) — somente no servidor. A chave NUNCA vai para o navegador. ──
# live:  defina BRAVOPAY_API_KEY
# mock:  BRAVOPAY_MODE=mock gera um PIX fictício (não pagável) só fora de produção
# off:   sem chave → PIX indisponível
BRAVOPAY_API_KEY=
BRAVOPAY_WEBHOOK_SECRET=
# Opcional:
# BRAVOPAY_MODE=mock
# BRAVOPAY_BASE_URL=https://bravopay.club/api/v1
# BRAVOPAY_PRODUCT_ID=

# ── Meta Pixel (navegador) + Conversions API (servidor) ──
# Pixel público atual (compatibilidade com configuração existente):
NEXT_PUBLIC_META_PIXEL_ID=
# Pixels adicionais no navegador, separados por vírgula; pode incluir o ID atual também:
NEXT_PUBLIC_META_PIXEL_IDS=
# Token(s) do CAPI (servidor). Formato: pixelId:token (vários pares separados por vírgula).
# Para adicionar um Pixel sem editar a variável de tokens existente, use a variável adicional abaixo.
META_CAPI_TOKENS=
# Par(es) CAPI adicional(is), também no formato pixelId:token; não substitui META_CAPI_TOKENS.
META_CAPI_TOKENS_ADDITIONAL=
# Compatibilidade: token de um único pixel junto com NEXT_PUBLIC_META_PIXEL_ID.
META_ACCESS_TOKEN=
# Opcional:
# META_GRAPH_VERSION=v21.0
# META_TEST_EVENT_CODE=

# ── E-mails transacionais (compra aprovada, PIX expirado, carrinho abandonado) ──
# Remetente (não precisa de caixa de e-mail, só do domínio verificado):
EMAIL_FROM="Somos Todos PT <no-reply@somostodospt.shop>"
# Opção A (recomendada) — Resend: verifique o domínio e cole a API key:
RESEND_API_KEY=
# Opção B — SMTP (exige conta de e-mail):
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_HOST=smtpout.secureserver.net
# EMAIL_PORT=465

# ── Cron (recuperação/expiração) ──
# Configure o cron-job.org para chamar /api/cron?key=<este valor> a cada 2–5 min.
CRON_SECRET=

# ── Painel admin (/admin) ──
# Defina UMA: hash sha256 da senha (recomendado) OU a senha em texto.
# Gere o hash:  node -e "console.log(require('crypto').createHash('sha256').update('SUA_SENHA').digest('hex'))"
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# ── Google (opcionais) ──
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
